{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build CSS Language Server",
			"type": "shell",
			"command": "npm run build",
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared"
			}
		},
		{
			"label": "Watch CSS Language Server",
			"type": "shell",
			"command": "npm run watch",
			"group": "build",
			"isBackground": true,
			"problemMatcher": ["$tsc-watch"],
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared"
			}
		},
		{
			"label": "Start CSS Language Server",
			"type": "shell",
			"command": "npm start",
			"group": "test",
			"dependsOn": "Build CSS Language Server",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			}
		},
		{
			"label": "Clean CSS Language Server",
			"type": "shell",
			"command": "npm run clean",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared"
			}
		}
	]
}