---
import { BlackbyteLogoSvg, BlackbytePictoSvg } from '@blackbyte/website-common';
import Search from '../search/search.astro';
import './header.css';
import { type THeader } from './header.type';

type Props = THeader;

let versionHtml = `v${Astro.props.websiteConfig.version.split('-')[0]}`;
const pseudoVersion = Astro.props.websiteConfig.version.split('-')[1];
if (pseudoVersion) {
  versionHtml += `-<span class="header_version-pseudo">${pseudoVersion}</span>`;
}
---

<header class="header">
  <div class="container">
    <div class="header_brand">
      <a href="/" title={Astro.props.websiteConfig.title}>
        <div class="header_logo">
          <Fragment set:html={BlackbyteLogoSvg} />
        </div>
        <div class="header_picto">
          <Fragment set:html={BlackbytePictoSvg} />
        </div>
        <h1 class="header_title font-family-brand">
          {Astro.props.websiteConfig.title}
        </h1>
      </a>
    </div>
    <div class="header_search">
      <Search menu={Astro.props.websiteConfig.menu} />
    </div>
    <div class="header_metas">
      <p class="header_version">
        <Fragment set:html={versionHtml} />
      </p>
      <a
        class="header_license"
        href={Astro.props.websiteConfig.license.url}
        target="_blank"
        title={Astro.props.websiteConfig.license.name}
      >
        {Astro.props.websiteConfig.license.name}
      </a>
      <a
        class="header_github"
        href={Astro.props.websiteConfig.repository.url}
        title={Astro.props.websiteConfig.repository.name}
        target="_blank"
      >
        <s-icon name="github" provider="pixelarticons" type="brands"></s-icon>
      </a>
    </div>
  </div>
</header>
