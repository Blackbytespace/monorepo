---
import { BlackbyteLogoSvg } from '@blackbyte/website-common';
import Search from '../search/search.astro';
import { type THeader } from './header.type';

type Props = THeader;

const { title, version, license, repository } = Astro.props;
let versionHtml = `v${version.split('-')[0]}`;
const pseudoVersion = version.split('-')[1];
if (pseudoVersion) {
  versionHtml += `-<span class="header_version-pseudo">${pseudoVersion}</span>`;
}
---

<header class="header">
  <div class="container">
    <div class="header_brand">
      <a href="/" title={title}>
        <div class="header_logo">
          <Fragment set:html={BlackbyteLogoSvg} />
        </div>
        <h1 class="header_title font-family-brand">{title}</h1>
      </a>
    </div>
    <div class="header_search">
      <Search menu={Astro.props.menu} />
    </div>
    <div class="header_metas">
      <p class="header_version">
        <Fragment set:html={versionHtml} />
      </p>
      <a
        class="header_license"
        href={license.url}
        target="_blank"
        title={license.name}
      >
        {license.name}
      </a>
      <a
        class="header_github"
        href={repository.url}
        title={repository.name}
        target="_blank"
      >
        <s-icon name="github" provider="pixelarticons" type="brands"></s-icon>
      </a>
    </div>
  </div>
</header>
