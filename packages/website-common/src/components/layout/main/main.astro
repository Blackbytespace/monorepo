---
import Layout from '../layout/layout.astro';
import Header from '../header/header.astro';
import Footer from '../footer/footer.astro';
import type { TMain } from './main.type';
import './main';

type Props = TMain;
---

<script>
  import { features } from '@blackbyte/sugar/feature';
  import Lenis from 'lenis';

  new Lenis({
    autoRaf: true,
    anchors: true,
    allowNestedScroll: true,
  });

  features('all');

  document.addEventListener('astro:page-load', () => {
    if (document.location.pathname === '/') {
      document.body.classList.add('-home');
    } else {
      document.body.classList.remove('-home');
    }
  });
</script>

<Layout
  pageTitle={Astro.props.pageTitle}
  websiteConfig={Astro.props.websiteConfig}
>
  <main class="main">
    {
      Astro.props.header !== false ? (
        <Header websiteConfig={Astro.props.websiteConfig} />
      ) : (
        ''
      )
    }

    <div class="main_body">
      <div class="container">
        <slot />
      </div>
    </div>
  </main>

  {
    Astro.props.footer !== false ? (
      <Footer websiteConfig={Astro.props.websiteConfig} />
    ) : (
      ''
    )
  }
</Layout>
