---
import Layout from '../layout/layout.astro';
import Header from '../header/header.astro';
import Footer from '../footer/footer.astro';
import type { TMain } from './main.type';
import './main';

type Props = TMain;
---

<script>
  import { scrollClasses, sectionClasses } from '@blackbyte/sugar/feature';
  import Lenis from 'lenis';

  const lenis = new Lenis({
    autoRaf: true,
    anchors: true,
    allowNestedScroll: true,
  });

  scrollClasses();
  sectionClasses();

  document.addEventListener('astro:page-load', () => {
    if (document.location.pathname === '/') {
      document.body.classList.add('-home');
    } else {
      document.body.classList.remove('-home');
    }
  });
</script>

<Layout websiteConfig={Astro.props.websiteConfig}>
  <main class="main">
    <Header websiteConfig={Astro.props.websiteConfig} />

    <div class="main_body">
      <div class="container">
        <slot />
      </div>
    </div>
  </main>

  <Footer websiteConfig={Astro.props.websiteConfig} />
</Layout>
