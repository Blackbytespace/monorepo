---
import { fade } from 'astro:transitions';
import Layout from '../layout/layout.astro';
import Header from '../header/header.astro';
import Footer from '../footer/footer.astro';
import './main';
import __logoBlackbyte from '@blackbyte/website-common/src/img/blackbyte-logo-picto.svg?raw';
import type { TMain } from './main.type';

type Props = TMain;
---

<script>
  import { scrollClasses, sectionClasses } from '@blackbyte/sugar/feature';
  import Lenis from 'lenis';

  const lenis = new Lenis({
    autoRaf: true,
    anchors: true,
    allowNestedScroll: true,
  });

  scrollClasses();
  sectionClasses();

  document.addEventListener('astro:page-load', () => {
    if (document.location.pathname === '/') {
      document.body.classList.add('-home');
    } else {
      document.body.classList.remove('-home');
    }
  });
</script>

<Layout
  title={Astro.props.title}
  pageTitle={Astro.props.pageTitle}
  description={Astro.props.description}
  license={Astro.props.license}
  version={Astro.props.version}
  repository={Astro.props.repository}
  og={Astro.props.og}
>
  <main class="main">
    <Header
      title={Astro.props.title}
      version={Astro.props.version}
      license={Astro.props.license}
      repository={Astro.props.repository}
      menu={Astro.props.menu}
    />

    <div class="main_body" transition:animate={fade({ duration: '0.1s' })}>
      <div class="container">
        <slot />
      </div>
    </div>
  </main>

  <Footer
    title={Astro.props.title}
    version={Astro.props.version}
    license={Astro.props.license}
    repository={Astro.props.repository}
  />
</Layout>
