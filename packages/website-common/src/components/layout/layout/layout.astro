---
import '../../settings/fonts/fonts';
import '../../settings/fonts/fonts.css';
import Posthog from '../../system/posthog/posthog.astro';
import './layout.css';
import type { TLayout } from './layout.type';

type Props = TLayout;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      property="og:site_name"
      content={`Blackbyte ${Astro.props.pageTitle ? `- ${Astro.props.pageTitle}` : ''}`}
    />
    <meta name="description" content={Astro.props.websiteConfig.description} />
    <meta name="generator" content={Astro.generator} />
    <meta
      property="og:description"
      content={Astro.props.websiteConfig.description}
    />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={Astro.props.websiteConfig.pageTitle} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={Astro.props.websiteConfig.og.imageUrl} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <title>
      Blackbyte {`${Astro.props.pageTitle ? `- ${Astro.props.pageTitle}` : ''}`}
    </title>
    <Posthog projectApiKey={Astro.props.websiteConfig.posthog.projectApiKey} />
  </head>
  <body>
    <slot />
  </body>
</html>
